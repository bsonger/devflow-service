  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "namespace",
        "query": "devflow,devflow-pre-production",
        "current": {
          "selected": true,
          "text": "devflow-pre-production",
          "value": "devflow-pre-production"
        },
        "includeAll": false,
        "multi": false,
        "options": [
          {
            "selected": false,
            "text": "devflow",
            "value": "devflow"
