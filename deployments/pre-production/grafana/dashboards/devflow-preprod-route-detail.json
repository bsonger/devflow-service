{
  "id": null,
  "uid": "devflow-preprod-route-detail",
  "title": "Page/API / Route Detail",
  "tags": [
    "devflow",
    "pre-production",
    "route-detail"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "namespace",
        "query": "devflow,devflow-pre-production",
        "current": {
          "selected": true,
          "text": "devflow-pre-production",
          "value": "devflow-pre-production"
        },
        "includeAll": false,
        "multi": false,
        "options": [
          {
            "selected": false,
            "text": "devflow",
            "value": "devflow"
          },
          {
            "selected": true,
            "text": "devflow-pre-production",
            "value": "devflow-pre-production"
          }
        ]
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "P1809F7CD0C75ACF3"
        },
        "definition": "label_values(http_server_requests_total{namespace=\"$namespace\"}, service_name)",
        "query": {
          "query": "label_values(http_server_requests_total{namespace=\"$namespace\"}, service_name)",
          "refId": "Prometheus-service-Variable-Query"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "P1809F7CD0C75ACF3"
        },
        "definition": "label_values(http_server_requests_total{namespace=\"$namespace\",service_name=~\"$service\"}, http_route)",
        "query": {
          "query": "label_values(http_server_requests_total{namespace=\"$namespace\",service_name=~\"$service\"}, http_route)",
          "refId": "Prometheus-route-Variable-Query"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Selected route patterns",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(count by (http_route) (http_server_requests_total{namespace=\"$namespace\",service_name=~\"$service\",http_route=~\"$route\"}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Contributing services",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(count by (service_name) (http_server_requests_total{namespace=\"$namespace\",service_name=~\"$service\",http_route=~\"$route\"}))",
