      "targets": [
        {
          "expr": "topk(20, sum by (service_name, dependency, action) (rate(devflow_dependency_errors_total{namespace=\"$namespace\"}[5m])) / clamp_min(sum by (service_name, dependency, action) (rate(devflow_dependency_calls_total{namespace=\"$namespace\"}[5m])), 0.0001))",
          "legendFormat": "{{service_name}} {{dependency}} {{action}}",
