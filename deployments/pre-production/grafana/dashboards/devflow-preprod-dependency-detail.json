{
  "id": null,
  "uid": "devflow-preprod-dependency-detail",
  "title": "Service / Dependency",
  "tags": [
    "devflow",
    "pre-production",
    "dependency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "namespace",
        "query": "devflow,devflow-pre-production",
        "current": {
          "selected": true,
          "text": "devflow-pre-production",
          "value": "devflow-pre-production"
        },
        "includeAll": false,
        "multi": false,
        "options": [
          {
            "selected": false,
            "text": "devflow",
            "value": "devflow"
          },
          {
            "selected": true,
            "text": "devflow-pre-production",
            "value": "devflow-pre-production"
          }
        ]
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "P1809F7CD0C75ACF3"
        },
        "definition": "label_values(http_server_requests_total{namespace=\"$namespace\"}, service_name)",
        "query": {
          "query": "label_values(http_server_requests_total{namespace=\"$namespace\"}, service_name)",
          "refId": "Prometheus-service-Variable-Query"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "P1809F7CD0C75ACF3"
        },
        "definition": "label_values(http_server_requests_total{namespace=\"$namespace\",service_name=~\"$service\"}, http_route)",
        "query": {
          "query": "label_values(http_server_requests_total{namespace=\"$namespace\",service_name=~\"$service\"}, http_route)",
          "refId": "Prometheus-route-Variable-Query"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Dependency calls / 5m",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(devflow_dependency_calls_total{namespace=\"$namespace\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Dependency errors / 5m",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(devflow_dependency_errors_total{namespace=\"$namespace\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Dependency error ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(devflow_dependency_errors_total{namespace=\"$namespace\"}[5m])) / clamp_min(sum(rate(devflow_dependency_calls_total{namespace=\"$namespace\"}[5m])), 0.0001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Call rate by dependency/action",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(20, sum by (service_name, dependency, action) (rate(devflow_dependency_calls_total{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "{{service_name}} {{dependency}} {{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Error rate by dependency/action",
      "type": "timeseries",
      "datasource": {
