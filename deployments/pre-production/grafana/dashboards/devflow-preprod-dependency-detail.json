        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(20, sum by (service_name, dependency, action) (rate(devflow_dependency_errors_total{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "{{service_name}} {{dependency}} {{action}}",
          "refId": "A"
