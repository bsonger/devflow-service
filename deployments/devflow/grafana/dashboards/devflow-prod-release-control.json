{
  "id": null,
  "uid": "devflow-prod-release-control",
  "title": "Delivery / Release",
  "tags": [
    "devflow",
    "production",
    "release"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "namespace",
        "query": "devflow,devflow-pre-production",
        "current": {
          "selected": true,
          "text": "devflow",
          "value": "devflow"
        },
        "includeAll": false,
        "multi": false,
        "options": [
          {
            "selected": true,
            "text": "devflow",
            "value": "devflow"
          },
          {
            "selected": false,
            "text": "devflow-pre-production",
            "value": "devflow-pre-production"
          }
        ]
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "P1809F7CD0C75ACF3"
        },
        "definition": "label_values(http_server_requests_total{namespace=\"$namespace\"}, service_name)",
        "query": {
          "query": "label_values(http_server_requests_total{namespace=\"$namespace\"}, service_name)",
          "refId": "Prometheus-service-Variable-Query"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "P1809F7CD0C75ACF3"
        },
        "definition": "label_values(http_server_requests_total{namespace=\"$namespace\",service_name=~\"$service\"}, http_route)",
        "query": {
          "query": "label_values(http_server_requests_total{namespace=\"$namespace\",service_name=~\"$service\"}, http_route)",
          "refId": "Prometheus-route-Variable-Query"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Created releases / 1h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(release_total{namespace=\"$namespace\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Succeeded / 1h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(release_success_total{namespace=\"$namespace\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Failed / 1h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(release_failed_total{namespace=\"$namespace\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Rollback / 1h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(deployment_rollback_total{namespace=\"$namespace\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Release throughput by type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (release_type) (rate(release_total{namespace=\"$namespace\"}[15m]))",
          "legendFormat": "created {{release_type}}",
          "refId": "A"
        },
        {
          "expr": "sum by (release_type) (rate(release_success_total{namespace=\"$namespace\"}[15m]))",
          "legendFormat": "succeeded {{release_type}}",
          "refId": "B"
        },
        {
          "expr": "sum by (release_type) (rate(release_failed_total{namespace=\"$namespace\"}[15m]))",
          "legendFormat": "failed {{release_type}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Release duration p50/p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (release_type, le) (rate(release_duration_seconds_bucket{namespace=\"$namespace\"}[15m])))",
          "legendFormat": "p50 {{release_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (release_type, le) (rate(release_duration_seconds_bucket{namespace=\"$namespace\"}[15m])))",
          "legendFormat": "p95 {{release_type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Release failure ratio by type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (release_type) (rate(release_failed_total{namespace=\"$namespace\"}[15m])) / clamp_min(sum by (release_type) (rate(release_total{namespace=\"$namespace\"}[15m])), 0.0001)",
          "legendFormat": "{{release_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Rollbacks by type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (release_type) (rate(deployment_rollback_total{namespace=\"$namespace\"}[15m]))",
          "legendFormat": "{{release_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Release totals by type (24h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P1809F7CD0C75ACF3"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (release_type) (increase(release_total{namespace=\"$namespace\"}[24h]))",
          "legendFormat": "created {{release_type}}",
          "refId": "A"
        },
        {
          "expr": "sum by (release_type) (increase(release_success_total{namespace=\"$namespace\"}[24h]))",
          "legendFormat": "succeeded {{release_type}}",
          "refId": "B"
        },
        {
          "expr": "sum by (release_type) (increase(release_failed_total{namespace=\"$namespace\"}[24h]))",
          "legendFormat": "failed {{release_type}}",
          "refId": "C"
        },
        {
          "expr": "sum by (release_type) (increase(deployment_rollback_total{namespace=\"$namespace\"}[24h]))",
          "legendFormat": "rollback {{release_type}}",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
